NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/karnainmd?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-this-immediately
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
PAIR_COOLDOWN_SECONDS=60
MAX_PAIR_ATTEMPTS_PER_HOUR=5
